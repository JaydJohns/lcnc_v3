{
  "name": "LCNC Course Stack Fallback",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [3000, 5678, 8080],
  "portsAttributes": {
    "3000": {
      "label": "ToolJet — course internal-tool builder",
      "onAutoForward": "ignore",
      "protocol": "http"
    },
    "5678": {
      "label": "n8n — workflow automation",
      "onAutoForward": "ignore",
      "protocol": "http"
    },
    "8080": {
      "label": "Baserow — no-code database",
      "onAutoForward": "ignore",
      "protocol": "http"
    },
    "5433": {
      "label": "Course PostgreSQL — do not forward",
      "onAutoForward": "ignore"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
